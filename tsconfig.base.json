{
    "compilerOptions": {
        // "typeRoots": ["./node_modules/@types", "../../packages/types"],
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "customConditions": ["worked"],
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "noErrorTruncation": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".", // This enables consistent relative paths across apps
        "paths": {
            "@/*": ["../../*"], // This only really makes sense for the apps
            "@comend/lib/*": ["lib/*"],
            "@/components/*": ["components/*"],
            "@/state/*": ["state/*"],
            "@comend/data/*": ["data/*"],
            "@/public/*": ["public/*"],
            "@/loading": ["loading.tsx"],
        }
    },
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
