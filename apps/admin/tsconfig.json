{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".", // makes paths relative to `apps/admin`
    "paths": {
      "@/*": ["../../*"],
      "~admin/*": ["./*"],
      "~web/*": ["./__invalid__"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "../web", "../provider"]
}
