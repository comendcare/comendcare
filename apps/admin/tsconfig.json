{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".", // makes paths relative to `apps/admin`
    "paths": {
      "~admin/*": ["./*"],
      "@/lib/*": ["@comend/lib/*"],
      "@/components/*": ["@comend/components/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "../web", "../provider"]
}
