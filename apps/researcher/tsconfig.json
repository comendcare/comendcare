{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".", // makes paths relative to `apps/admin`
    "paths": {
      // enabling this causes issues on vercel builds, it tries to import /web, which 
      // causes issues with the ~web/ import alias
      // "@/*": ["../../*"],
      "~researcher/*": ["./*"],
      "@/state/*": ["../../state/*"],
      "@/public/*": ["../../public/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/components/marketplace/clinical-datasets/clinical-dataset-tools-page.tsx", "../../packages/components/marketplace/biosamples/biosample-tools-page.tsx", "../../packages/components/marketplace/disease-models/disease-model-tools-page.tsx"],
  "exclude": ["node_modules"]
}
