  researcherId             String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  submittedAt              DateTime
  approvedAt               DateTime?
  expiresAt                DateTime?
  sampleTypes              String[]
  dataTypes                String[]
  sampleCount              Int
  openToCollab             Boolean
  studyTitle               String
  studyDescription         String
  justification            String
  hasIrbApproval           Boolean
  irbStatus                String?
  hasRisks                 Boolean
  riskDescription          String?
  disseminationPlan        String
  patientSignificance      String
  otherSampleType          String?
  processingRequirements   String?
  timeline                 String
  logisticsContact         String
  providesCollectionKit    Boolean
  needsCollectionMaterials Boolean
  participantCompensation  Boolean
  compensationDetails      String?
  shippingAddress          String?
  fedexAccount             String?
  shippingMethod           String?
