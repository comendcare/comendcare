model Gene {
  id                   Int            @id @default(autoincrement()) // Auto-generated primary key
  uuid                 String?        @unique // Unique identifier for the record
  symbol               String?        @unique // Official gene symbol
  name                 String? // Full name of the gene or RNA
  hgncId               String? // HGNC identifier for the gene
  locusGroup           String? // Group classification (e.g., protein-coding gene, non-coding RNA)
  locusType            String? // Type of locus (e.g., gene with protein product, RNA, pseudogene)
  location             String? // Chromosomal location (e.g., 19q13.43)
  locationSortable     String? // Sortable location string
  entrezId             String? // NCBI Entrez Gene identifier
  ensemblGeneId        String?        @unique // Ensembl gene identifier
  ucscId               String? // UCSC Genome Browser identifier
  refseqAccessions     String[] // Array of RefSeq accession numbers
  vegaId               String? // Vega Genome Browser identifier
  omimIds              String[] // Array of OMIM IDs
  uniprotIds           String[] // Array of UniProt IDs
  aliasSymbols         String[] // Alternate symbols for the gene
  prevSymbols          String[] // Previously used symbols
  prevNames            String[] // Previously used names
  aliasNames           String[] // Alternate names for the gene
  geneGroups           String[] // Functional groups the gene belongs to
  geneGroupIds         Int[] // Array of group IDs for the functional groups
  pubmedIds            Int[] // Array of PubMed IDs referencing the gene
  agr                  String? // Alliance of Genome Resources ID
  status               String? // Approval status (e.g., "Approved")
  dateApprovedReserved DateTime? // Date when the record was approved or reserved
  dateModified         DateTime? // Last modification date
  dateNameChanged      DateTime? // Date when the gene's name was changed
  dateSymbolChanged    DateTime? // Date when the gene's symbol was changed
  rnaCentralIds        String[] // Array of RNA Central IDs (for RNA entities)
  lncipedia            String? // LncRNA-specific ID in Lncipedia
  pseudogeneOrg        String? // Pseudogene.org ID (for pseudogenes)
  merops               String? // MEROPS protease family ID
  maneSelect           String[] // MANE Select transcript IDs
  ena                  String[] // Array of ENA IDs
  ccdsIds              String[] // Array of CCDS IDs
  rgdIds               String[] // Array of RGD IDs (Rat Genome Database)
  mgdIds               String[] // Array of MGD IDs (Mouse Genome Database)
  orphanet             Int? // Orphanet ID for rare diseases
  lsdb                 String[] // Locus-Specific Database links
  metadata             Json?
  Biosample            Biosample[]
  DiseaseModel         DiseaseModel[]
  Tool                 Tool[]

  @@index([symbol], map: "idx_symbol") // Index for faster search by symbol
}

model Company {
  id                              String                  @id @default(uuid())
  url                             String
  scientistDotComURL              String?
  title                           String
  description                     String?
  yearEstablished                 Int?
  website                         String?
  headquarters                    String?
  companyType                     String?
  sites                           Site[]
  services                        Service[]
  certifications                  Certification[]
  simplifiedCertifications        String[]
  rfis                            RFI[]
  reviews                         Review[]
  tags                            String[]
  avgRating                       Float?                  @default(0.0) // Stores the average rating of the company
  categories                      String[]
  milestoneTypes                  String[]
  savedByOrganizations            SavedCompany[]          @relation("cro_save_savedCompany")
  contactRequestedByOrganizations CompanyContactRequest[] @relation("cro_contact_request_company")
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @default(now()) @updatedAt
  metadata                        Json?
}

model SavedCompany {
  id             String @id @default(uuid())
  organizationId String
  companyId      String
  milestoneId    String
  // engagement     OrganizationToCompanyEngagement

  organization Organization @relation("cro_save_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation("cro_save_savedCompany", fields: [companyId], references: [id], onDelete: Cascade)
  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([organizationId, companyId]) // Ensures an organization can't save the same company more than once
}

model CompanyContactRequest {
  id             String @id @default(uuid())
  organizationId String
  companyId      String

  organization Organization @relation("cro_contact_request_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation("cro_contact_request_company", fields: [companyId], references: [id], onDelete: Cascade)

  timeline    String?
  services    CompanyContactRequestToService[]
  rfps        CompanyContactRequestToRFP[]
  description String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  metadata  Json?
}

model CompanyContactRequestToService {
  id                      String @id @default(uuid())
  companyContactRequestId String
  serviceId               String

  companyContactRequest CompanyContactRequest @relation(fields: [companyContactRequestId], references: [id], onDelete: Cascade)
  service               Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([companyContactRequestId, serviceId])
}

model CompanyContactRequestToRFP {
  id                      String @id @default(uuid())
  companyContactRequestId String
  rfpId                   String

  companyContactRequest CompanyContactRequest @relation(fields: [companyContactRequestId], references: [id], onDelete: Cascade)
  rfp                   RFP                   @relation(fields: [rfpId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([companyContactRequestId, rfpId])
}

model Site {
  id        String  @id @default(uuid())
  name      String
  address   String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  metadata  Json?
}

model Service {
  id                             String                           @id @default(uuid())
  name                           String                           @unique
  description                    String?
  company                        Company[]
  metadata                       Json?
  companyContactRequestToService CompanyContactRequestToService[]
}

model Certification {
  id       String    @id @default(uuid())
  name     String    @unique
  company  Company[]
