generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(cuid())
  name                 String?
  // if you are using Github OAuth, you can get rid of the username attribute (that is for Twitter OAuth)
  username             String?
  title                String?
  gh_username          String?
  email                String?         @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  accounts             Account[]
  sessions             Session[]
  roadmaps             Roadmap[]
  firstName            String?
  lastName             String?
  organizations        Organization[]
  membershipRequests   MemberRequest[]
  memberships          Member[]
  sentInvitations      Member[]        @relation("invitedBy")
  deletedAt            DateTime?
  notificationSettings Boolean         @default(false)
  consentSettings      Boolean         @default(false)
  address1             String?
  address2             String?
  formattedAddress     String?
  city                 String?
  region               String?
  postalCode           String?
  country              String?
  lat                  Float?
  lng                  Float?
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role           String
  email          String
  // userId is nullable because we want to allow invites to be sent to emails that are not registered
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  invitedById    String?
  invitedBy      User?        @relation("invitedBy", fields: [invitedById], references: [id])
  // organizationId String
  // organization   Organization @relation(fields: [organizationId], references: [id])
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  @@unique([userId, organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  role           String       @db.VarChar
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  accepted       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([email, organizationId])
}

model MemberRequest {
  id             String       @id @default(cuid())
  userId         String
  email          String
  role           String       @db.VarChar
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  accepted       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([userId, organizationId])
}

enum ClientType {
  READ
  WRITE
  ROOT
}

enum IncorporationStatus {
  YES
  NO
  INPROGRESS
}

enum Goal {
  YES
  NO
  INPROGRESS
}

model Client {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  secret           String?
  type             ClientType @default(WRITE)
  organizationSlug String
  organizationId   String?
  cors             String?
  crossDomain      Boolean    @default(false)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  organization Organization? @relation(fields: [organizationId], references: [id])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Roadmap {
  id             String        @id @default(cuid())
  title          String?       @db.Text
  description    String?       @db.Text
  content        String?       @db.Text
  slug           String        @default(cuid())
  image          String?       @default("https://public.blob.vercel-storage.com/eEZHAoPTOBSYGBE3/hxfcV5V-eInX3jbVUhjAt1suB7zB88uGd1j20b.png") @db.Text
  imageBlurhash  String?       @default("data:image/png;base64,") @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  published      Boolean       @default(true)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String?
  nodes          Node[]
  edges          Edge[]
  milestones     Milestone[]

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([userId])
}

enum NodeType {
  MILESTONE
}

enum StatusType {
  TODO
  INPROGRESS
  DONE
}

model Node {
  id        String     @id @unique @default(uuid())
  type      String
  positionX Int
  positionY Int
  data      Milestone?
  roadmapId String
  roadmap   Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Milestone {
  id          String               @id @unique @default(uuid())
  node        Node?                @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nodeId      String?              @unique
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Int?
  papers      ExternalAttachment[]
  notes       String?
  status      StatusType
  tasks       Task[]
  roadmapId   String
  roadmap     Roadmap              @relation(fields: [roadmapId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  private     Boolean              @default(false)
  type        MilestoneType        @default(NOTYPE)
  RFP         RFP?                 @relation(fields: [RFPId], references: [id])
  RFPId       String?
  asset       Asset?               @relation(fields: [assetId], references: [id])
  assetId     String?
}

enum MilestoneType {
  BASICSCIENCE
  LITERATUREREVIEW
  CELLLINE
  ORGANOID
  ANIMALMODEL
  NATURALHISTORYSTUDY
  PATIENTREGISTRY
  BIOBANK
  BIOMARKERANALYSIS
  CONSTRUCTDESIGN
  PLASMIDPRODUCTION
  AAVPRODUCTION
  TARGETIDENTIFICATION
  DRUGSCREENING
  INVITROVERIFICATION
  INVIVOVERIFICATION
  PROOFOFCONCEPTSTUDY
  DOSINGSTUDY
  TOXICOLOGYSTUDY
  PREINDMEETING
  INDSUBMISSION
  NOTYPE
}

model Kanban {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  columns        Column[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Column {
  id        String   @id @unique @default(uuid())
  name      String   @default("New Column")
  kanbanId  String
  kanban    Kanban   @relation(fields: [kanbanId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kanbanPosition Int @default(0) // order position within the kanban board
}

model Task {
  id             String          @id @unique @default(uuid())
  status         StatusType?
  name           String          @default("")
  description    String?         @default("")
  checklist      ChecklistItem[]
  milestoneId    String? // Optional foreign key to associate with a milestone
  milestone      Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  columnId       String // Foreign key to associate with a column
  column         Column          @relation(fields: [columnId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  date           DateTime?       @default(now())
  orderPosition  Int // order position in the milestone task list
  kanbanPosition Int // order position within the kanban column
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ChecklistItem {
  id            String  @id @unique @default(uuid())
  name          String
  complete      Boolean
  taskId        String
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderPosition Int? // order position in the task checklist
}

model RFP {
  id            String               @id @unique @default(uuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  name          String
  funding       Int
  description   String?
  contacts      ExternalContact[]
  attachments   ExternalAttachment[]
  researchFocus MilestoneType        @default(NOTYPE)
  openTo        RFPOpenToType        @default(ALL)
  startDate     DateTime?
  endDate       DateTime?
  Milestone     Milestone[]
}

model Asset {
  id          String               @id @unique @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  name        String
  description String?
  contacts    ExternalContact[]
  attachments ExternalAttachment[]
  Milestone   Milestone[]
}

model ExternalAttachment {
  id          String     @id @unique @default(uuid())
  name        String?
  link        String
  RFP         RFP?       @relation(fields: [rFPId], references: [id])
  rFPId       String?
  Asset       Asset?     @relation(fields: [assetId], references: [id])
  assetId     String?
  Milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  milestoneId String?
}

model ExternalContact {
  id      String  @id @unique @default(uuid())
  name    String
  role    String?
  email   String
  RFP     RFP?    @relation(fields: [rFPId], references: [id])
  rFPId   String?
  Asset   Asset?  @relation(fields: [assetId], references: [id])
  assetId String?
}

enum RFPOpenToType {
  CRO
  ACADEMIC
  ALL
  NONE
}

model Edge {
  id        String  @id @unique @default(uuid())
  source    String
  target    String
  type      String?
  data      Json?
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Organization {
  id                          String                    @id @default(cuid())
  public                      Boolean                   @default(true)
  verified                    Boolean                   @default(false)
  name                        String?
  description                 String?                   @db.Text
  logo                        String?                   @default("https://public.blob.vercel-storage.com/eEZHAoPTOBSYGBE3/JRajRyC-PhBHEinQkupt02jqfKacBVHLWJq7Iy.png") @db.Text
  font                        String                    @default("font-cal")
  image                       String?                   @default("https://public.blob.vercel-storage.com/eEZHAoPTOBSYGBE3/hxfcV5V-eInX3jbVUhjAt1suB7zB88uGd1j20b.png") @db.Text
  imageBlurhash               String?                   @default("data:image/png;base64,") @db.Text
  subdomain                   String?                   @unique
  customDomain                String?                   @unique
  message404                  String?                   @default("Blimey! You've found a page that doesn't exist.") @db.Text
  statedGoal                  Goal?
  dateFounded                 DateTime?
  incorporationStatus         IncorporationStatus?
  website                     String?
  moneyRaised                 Int?
  moneyDeployed               Int?
  researchBudget              Int?
  interestedModalities        String[]
  diseaseName                 String?
  diseaseCategories           String[]
  prevalenceNumerator         Int?
  prevalenceDenominator       Int?
  prevalenceRatio             Float?
  numberOfIdentifiedPatients  Int?
  relevantDiseaseMechanisms   String[]
  associatedGenes             String[]
  associatedSignsAndSymptoms  String[]
  existingDatabasesAndStudies String[]
  assetsUnderDevelopment      String[]
  address1                    String?
  address2                    String?
  formattedAddress            String?
  city                        String?
  region                      String?
  postalCode                  String?
  country                     String?
  lat                         String?
  lng                         String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  user                        User?                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId                      String?
  roadmaps                    Roadmap[]
  members                     Member[]
  client                      Client[]
  invitation                  Invitation[]
  membershipRequest           MemberRequest[]
  condition                   ConditionToOrganization[]
  Kanban                      Kanban?

  @@index([userId])
}

model Condition {
  id                          String                    @id @default(cuid())
  name                        String
  slug                        String                    @unique
  nordURL                     String?
  gardURL                     String?
  description                 String?                   @db.Text
  summary                     String?                   @db.Text
  interestedModalities        String[]
  diseaseCategories           String[]
  prevalenceNumerator         Int?
  prevalenceDenominator       Int?
  prevalenceRatio             Float?
  numberOfIdentifiedPatients  Int?
  relevantDiseaseMechanisms   String[]
  associatedGenes             String[]
  associatedSignsAndSymptoms  String[]
  existingDatabasesAndStudies String[]
  assetsUnderDevelopment      String[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  organizations               ConditionToOrganization[]
}

// Normally, an imlpicit relation would do, but this is necessary for prisma pulse replication.
// See https://www.prisma.io/docs/pulse/database-setup/general-database-instructions#replica-identity
model ConditionToOrganization {
  conditionId    String
  organizationId String

  // Relations
  condition    Condition    @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite Primary Key
  @@id([conditionId, organizationId])
}

model Example {
  id            Int     @id @default(autoincrement())
  name          String?
  description   String? @db.Text
  domainCount   Int?
  url           String?
  image         String? @db.Text
  imageBlurhash String? @db.Text
}
