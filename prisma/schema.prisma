generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewReplyReportReason {
  HARASSMENT
  FALSE
  SPAM
  SALES
  HATE
  OTHER
}

enum OrganizationToCompanyEngagement {
  EXPLORING
  QUOTE
  COLLABORATING
  COLLABORATED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String? /// @encrypted
  nameHash              String? /// @encryption:hash(name)
  username              String?
  gh_username           String?
  email                 String?                @unique /// @encrypted
  emailHash             String?                @unique /// @encryption:hash(email)
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  kanbanLastVisit       DateTime               @default(now())
  address1              String? /// @encrypted
  address1Hash          String? /// @encryption:hash(address1)
  address2              String? /// @encrypted
  address2Hash          String? /// @encryption:hash(address2)
  city                  String? /// @encrypted
  cityHash              String? /// @encryption:hash(city)
  country               String? /// @encrypted
  countryHash           String? /// @encryption:hash(country)
  formattedAddress      String? /// @encrypted
  formattedAddressHash  String? /// @encryption:hash(formattedAddress)
  postalCode            String? /// @encrypted
  postalCodeHash        String? /// @encryption:hash(postalCode)
  region                String? /// @encrypted
  regionHash            String? /// @encryption:hash(region)
  lat                   String? /// @encrypted
  latHash               String? /// @encryption:hash(lat)
  lng                   String? /// @encrypted
  lngHash               String? /// @encryption:hash(lng)
  notificationSettings  Boolean                @default(false)
  consentSettings       Boolean                @default(false)
  accounts              Account[]
  comments              Comment[]
  follows               Follow[]
  sentInvitations       Member[]               @relation("invitedBy")
  memberships           Member[]
  membershipRequests    MemberRequest[]
  organizations         Organization[]
  posts                 Post[]
  reactions             Reaction[]
  roadmaps              Roadmap[]
  sessions              Session[]
  stakeholders          TaskStakeholder[]
  platformNotifications PlatformNotification[]
  reviews               Review[]
  replies               Reply[]
  reportOnReviews       ReportOnReview[]
  reportOnReplies       ReportOnReply[]
  reviewFeedbacks       ReviewFeedback[]
  metadata              Json?
}

model PlatformNotification {
  id             String       @id @default(uuid())
  type           String // Stores the notification type (e.g. "NEW_TASK", "NEW_RECOMMENDATION")
  title          String
  message        String?
  link           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastViewedAt   DateTime?
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata       Json? // Stores additional information associated with this notification, e.g. for recommendations - company & milestone id

  @@index([userId, createdAt, lastViewedAt])
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role           String       @default("member") @db.VarChar
  title          String?
  email          String /// @encrypted
  emailHash      String? /// @encryption:hash(email)
  userId         String
  invitedById    String?
  meta           Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organizationId String
  invitedBy      User?        @relation("invitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata       Json?

  @@unique([userId, organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String /// @encrypted
  emailHash      String? /// @encryption:hash(email)
  role           String       @default("member") @db.VarChar
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  accepted       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata       Json?

  @@unique([emailHash, organizationId])
}

model MemberRequest {
  id             String       @id @default(cuid())
  userId         String
  email          String /// @encrypted
  emailHash      String? /// @encryption:hash(email)
  role           String       @default("member") @db.VarChar
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata       Json?

  @@unique([userId, organizationId])
}

model Client {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  secret           String?
  type             ClientType    @default(WRITE)
  organizationSlug String
  organizationId   String?
  cors             String?
  crossDomain      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  organization     Organization? @relation(fields: [organizationId], references: [id])
  metadata         Json?
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata                 Json?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata     Json?

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid()) // PostgreSQL requires a primary key or explicitly defined replica identity for logical replication to track deletions.
  identifier String
  token      String   @unique
  expires    DateTime
  metadata   Json?

  @@unique([identifier, token])
}

model Roadmap {
  id             String        @id @default(cuid())
  title          String?
  description    String?
  content        String?
  slug           String        @default(cuid())
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  published      Boolean       @default(true)
  organizationId String?
  userId         String?
  edges          Edge[]
  milestones     Milestone[]
  nodes          Node[]
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  modalities     String[]
  metadata       Json?

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Node {
  id        String     @id @unique @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  positionX Int
  positionY Int
  origin    Float[]    @default([0.0, 0.0])
  roadmapId String
  data      Milestone?
  roadmap   Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  metadata  Json?
}

model Milestone {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  title            String
  description      String?
  notes            String?
  status           String?                    @default("PLANNED")
  budget           Int?
  endDate          DateTime?
  startDate        DateTime?
  private          Boolean                    @default(true)
  types            MilestoneTypeOnMilestone[]
  otherTypeDetails String?
  openTo           String[]
  tasks            Task[]
  attachments      ExternalAttachment[]
  contacts         ExternalContact[]
  timelineOrder    Int                        @default(0)
  nodeType         String                     @default("PROJECT")

  tools ToolToMilestone[]
  rfps  RFPToMilestone[]

  roadmapId      String
  roadmap        Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodeId         String?      @unique
  node           Node?        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  metadata       Json?

  reviews        MilestoneToReview[]
  savedCompanies SavedCompany[]
}

model Tool {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  title       String               @default("Untitled Asset")
  description String?
  contacts    ExternalContact[]
  attachments ExternalAttachment[]
  private     Boolean              @default(true)
  pinned      Boolean              @default(false)
  metadata    Json?

  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones     ToolToMilestone[]
}

model ToolToMilestone {
  id          String @id @default(uuid())
  toolId      String
  milestoneId String

  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  metadata  Json?

  @@unique([toolId, milestoneId])
}

model RFP {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  title       String               @default("Untitled RFP")
  description String?
  openTo      String[]
  startDate   DateTime? // request opens
  endDate     DateTime? // deadline for proposals
  contacts    ExternalContact[]
  attachments ExternalAttachment[]
  budget      Int?
  private     Boolean              @default(true)
  headerImage String?              @db.Text
  pinned      Boolean              @default(false)
  metadata    Json?

  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones     RFPToMilestone[]
}

model RFPToMilestone {
  id          String @id @default(uuid())
  rfpId       String
  milestoneId String

  rfp       RFP       @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  metadata  Json?

  @@unique([rfpId, milestoneId])
}

model MilestoneToReview {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  reviewId    String
  review      Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  metadata    Json?
}

model MilestoneTypeOnMilestone {
  id              String        @id @default(uuid())
  milestoneTypeId String
  milestoneId     String
  milestoneType   MilestoneType @relation(fields: [milestoneTypeId], references: [id], onDelete: Cascade)
  milestone       Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  metadata        Json?

  @@unique([milestoneTypeId, milestoneId])
}

model MilestoneType {
  id          String   @id // value
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  label       String
  services    String[]
  categories  String[]
  description String?
  metadata    Json?

  milestones MilestoneTypeOnMilestone[]
}

model Kanban {
  id             String       @id @default(uuid())
  organizationId String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  columns        Column[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata       Json?
}

model Column {
  id             String   @id @unique @default(uuid())
  name           String   @default("New Column")
  kanbanId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  kanbanPosition Int      @default(0)
  kanban         Kanban   @relation(fields: [kanbanId], references: [id], onDelete: Cascade)
  tasks          Task[]
  metadata       Json?
}

model Task {
  id             String            @id @unique @default(uuid())
  status         String?           @default("PLANNED")
  name           String            @default("")
  description    String?           @default("")
  milestoneId    String?
  kanbanPosition Int
  orderPosition  Int
  columnId       String
  createdAt      DateTime          @default(now())
  date           DateTime?         @default(now())
  updatedAt      DateTime          @updatedAt
  endDate        DateTime?
  priority       String?
  private        Boolean           @default(true)
  startDate      DateTime?
  checklist      ChecklistItem[]
  column         Column            @relation(fields: [columnId], references: [id], onDelete: Cascade)
  milestone      Milestone?        @relation(fields: [milestoneId], references: [id])
  stakeholders   TaskStakeholder[]
  metadata       Json?
}

model TaskStakeholder {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata Json?

  @@unique([taskId, userId]) // Ensure uniqueness of the pair
}

model ChecklistItem {
  id            String  @id @unique @default(uuid())
  name          String
  complete      Boolean
  taskId        String
  orderPosition Int?
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  metadata      Json?
}

model ExternalAttachment {
  id   String  @id @unique @default(uuid())
  name String?
  link String

  toolId      String?
  tool        Tool?      @relation(fields: [toolId], references: [id])
  rfpId       String?
  rfp         RFP?       @relation(fields: [rfpId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  metadata    Json?
}

model ExternalContact {
  id          String  @id @unique @default(uuid())
  name        String /// @encrypted
  nameHash    String? /// @encryption:hash(name)
  role        String?
  email       String /// @encrypted
  emailHash   String? @unique /// @encryption:hash(email)
  affiliation String?

  toolId      String?
  tool        Tool?      @relation(fields: [toolId], references: [id])
  rfpId       String?
  rfp         RFP?       @relation(fields: [rfpId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  metadata    Json?
}

model Edge {
  id        String  @id @unique @default(uuid())
  source    String
  target    String
  type      String?
  data      Json?
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  metadata  Json?
}

model Organization {
  id                        String                    @id @default(cuid())
  public                    Boolean                   @default(true)
  verified                  Boolean                   @default(false)
  published                 Boolean                   @default(true)
  name                      String?
  description               String?                   @db.Text
  contactEmail              String?                   @unique /// @encrypted
  contactEmailHash          String?                   @unique /// @encryption:hash(contactEmail)
  logo                      String?                   @default("https://public.blob.vercel-storage.com/eEZHAoPTOBSYGBE3/JRajRyC-PhBHEinQkupt02jqfKacBVHLWJq7Iy.png") @db.Text
  font                      String                    @default("font-cal")
  image                     String?                   @db.Text
  imageBlurhash             String?                   @default("data:image/png;base64,") @db.Text
  headerImage               String?                   @db.Text
  biopharmaConsentSettings  Boolean                   @default(false)
  subdomain                 String?                   @unique
  customDomain              String?                   @unique
  message404                String?                   @default("Blimey! You've found a page that doesn't exist.") @db.Text
  statedGoal                Goal?
  yearFounded               String?
  incorporationStatus       IncorporationStatus?
  therapeuticsOfInterest    String[]
  therapeuticsInDevelopment String[]
  website                   String?
  moneyRaised               Int?
  moneyDeployed             Int?
  researchBudget            Int?
  address1                  String?
  address2                  String?
  formattedAddress          String?
  city                      String?
  region                    String?
  postalCode                String?
  country                   String?
  lat                       String?
  lng                       String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  user                      User?                     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId                    String?
  roadmaps                  Roadmap[]
  members                   Member[]
  clients                   Client[]
  invitations               Invitation[]
  membershipRequests        MemberRequest[]
  conditions                ConditionToOrganization[]
  kanban                    Kanban?
  milestones                Milestone[]
  platformNotifications     PlatformNotification[]
  reviews                   Review[]
  savedCompanies            SavedCompany[]
  tools                     Tool[]
  rfps                      RFP[]
  metadata                  Json?

  @@index([userId])
}

model Follow {
  id           String   @id @default(cuid())
  userId       String
  followedType String
  followedId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata     Json?

  @@unique([userId, followedType, followedId])
}

model Condition {
  id                          String                    @id @default(cuid())
  name                        String
  slug                        String                    @unique
  description                 String?
  diseaseCategories           String[]
  prevalenceNumerator         Int?
  prevalenceDenominator       Int?
  numberOfPatientsEngaged     Int?
  nationalEstimatedPopulation Int?
  globalEstimatedPopulation   Int?
  relevantDiseaseMechanisms   String[]
  causalGenes                 String[]
  associatedGenes             String[]
  associatedSystems           String[]
  associatedSignsAndSymptoms  String[]
  existingDatabasesAndStudies String[]
  toolsUnderDevelopment       String[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  gardURL                     String?
  nordURL                     String?
  summary                     String?
  prevalenceRatio             Float?
  organizations               ConditionToOrganization[]
  metadata                    Json?
}

model ConditionToOrganization {
  id             String  @id @default(uuid())
  conditionId    String?
  organizationId String?

  condition    Condition?    @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  metadata  Json?

  @@unique([conditionId, organizationId])
}

model Example {
  id            Int     @id @default(autoincrement())
  name          String?
  description   String?
  domainCount   Int?
  url           String?
  image         String?
  imageBlurhash String?
  metadata      Json?
}

model Post {
  id        String    @id @default(cuid())
  content   Json?
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  text      String?
  comments  Comment[]
  mentions  Mention[]
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  metadata  Json?
}

model Comment {
  id        String    @id @default(cuid())
  text      String
  userId    String
  postId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentions  Mention[]
  metadata  Json?
}

model Reaction {
  id            String   @id @default(cuid())
  type          String
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  reactableId   String
  reactableType String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  metadata      Json?

  @@unique([authorId, reactableType, reactableId])
}

enum ClientType {
  READ
  WRITE
  ROOT
}

enum IncorporationStatus {
  YES
  NO
  INPROGRESS
}

enum Goal {
  YES
  NO
  INPROGRESS
}

model Mention {
  id     String  @id @default(cuid())
  postId String? // For mentions in posts
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String? // For mentions in comments
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  mentionedType String
  mentionedId   String // ID of the mentioned entity (e.g., User, Roadmap, Organization, etc.)
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gene {
  id                   Int       @id @default(autoincrement()) // Auto-generated primary key
  uuid                 String?   @unique // Unique identifier for the record
  symbol               String?   @unique // Official gene symbol
  name                 String? // Full name of the gene or RNA
  hgncId               String? // HGNC identifier for the gene
  locusGroup           String? // Group classification (e.g., protein-coding gene, non-coding RNA)
  locusType            String? // Type of locus (e.g., gene with protein product, RNA, pseudogene)
  location             String? // Chromosomal location (e.g., 19q13.43)
  locationSortable     String? // Sortable location string
  entrezId             String? // NCBI Entrez Gene identifier
  ensemblGeneId        String?   @unique // Ensembl gene identifier
  ucscId               String? // UCSC Genome Browser identifier
  refseqAccessions     String[] // Array of RefSeq accession numbers
  vegaId               String? // Vega Genome Browser identifier
  omimIds              String[] // Array of OMIM IDs
  uniprotIds           String[] // Array of UniProt IDs
  aliasSymbols         String[] // Alternate symbols for the gene
  prevSymbols          String[] // Previously used symbols
  prevNames            String[] // Previously used names
  aliasNames           String[] // Alternate names for the gene
  geneGroups           String[] // Functional groups the gene belongs to
  geneGroupIds         Int[] // Array of group IDs for the functional groups
  pubmedIds            Int[] // Array of PubMed IDs referencing the gene
  agr                  String? // Alliance of Genome Resources ID
  status               String? // Approval status (e.g., "Approved")
  dateApprovedReserved DateTime? // Date when the record was approved or reserved
  dateModified         DateTime? // Last modification date
  dateNameChanged      DateTime? // Date when the gene's name was changed
  dateSymbolChanged    DateTime? // Date when the gene's symbol was changed
  rnaCentralIds        String[] // Array of RNA Central IDs (for RNA entities)
  lncipedia            String? // LncRNA-specific ID in Lncipedia
  pseudogeneOrg        String? // Pseudogene.org ID (for pseudogenes)
  merops               String? // MEROPS protease family ID
  maneSelect           String[] // MANE Select transcript IDs
  ena                  String[] // Array of ENA IDs
  ccdsIds              String[] // Array of CCDS IDs
  rgdIds               String[] // Array of RGD IDs (Rat Genome Database)
  mgdIds               String[] // Array of MGD IDs (Mouse Genome Database)
  orphanet             Int? // Orphanet ID for rare diseases
  lsdb                 String[] // Locus-Specific Database links
  metadata             Json?

  @@index([symbol], map: "idx_symbol") // Index for faster search by symbol
}

model Company {
  id                       String          @id @default(uuid())
  url                      String
  scientistDotComURL       String?
  title                    String
  description              String?
  yearEstablished          Int?
  website                  String?
  headquarters             String?
  companyType              String?
  sites                    Site[]
  services                 Service[]
  certifications           Certification[]
  simplifiedCertifications String[]
  rfis                     RFI[]
  reviews                  Review[]
  tags                     String[]
  avgRating                Float?          @default(0.0) // Stores the average rating of the company
  categories               String[]
  milestoneTypes           String[]
  savedByOrganizations     SavedCompany[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @default(now()) @updatedAt
  metadata                 Json?
}

model SavedCompany {
  id             String @id @default(uuid())
  organizationId String
  companyId      String
  milestoneId    String
  // engagement     OrganizationToCompanyEngagement

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([organizationId, companyId]) // Ensures an organization can't save the same company more than once
}

model Site {
  id        String  @id @default(uuid())
  name      String
  address   String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  metadata  Json?
}

model Service {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  company     Company[]
  metadata    Json?
}

model Certification {
  id       String    @id @default(uuid())
  name     String    @unique
  company  Company[]
  files    File[]
  metadata Json?
}

model File {
  id              String        @id @default(uuid())
  fileName        String
  fileUrl         String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String
  metadata        Json?
}

model RFI {
  id          String    @id @default(uuid())
  name        String
  submittedOn DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  metadata    Json?
}

model Review {
  id             String              @id @default(uuid())
  title          String
  body           String
  rating         Float               @default(0.0) // Stores the rating given by the user (can be 1-5, 1-10, etc.)
  authorId       String
  author         User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  replies        Reply[]             @relation("ReviewToReply")
  reports        ReportOnReview[]
  milestones     MilestoneToReview[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  feedbacks      ReviewFeedback[]
  metadata       Json?

  @@unique([authorId, companyId, organizationId]) // Ensures one review per user per company per organization
}

model ReviewFeedback {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean // true if the user found the review helpful, false otherwise
  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([reviewId, userId]) // Ensures a user can only provide feedback once per review
}

model Reply {
  id        String          @id @default(uuid())
  body      String
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review          @relation("ReviewToReply", fields: [reviewId], references: [id], onDelete: Cascade)
  reports   ReportOnReply[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  metadata  Json?
}

model ReportOnReview {
  id          String                  @id @default(uuid())
  userId      String
  reviewId    String
  reason      ReviewReplyReportReason
  description String?
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review      Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  metadata    Json?
}

model ReportOnReply {
  id          String                  @id @default(uuid())
  userId      String
  replyId     String
  reason      ReviewReplyReportReason
  description String?
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply       Reply                   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  metadata    Json?
}

model Whitelist {
  id        String   @id @default(cuid())
  email     String   @unique /// @encrypted
  emailHash String?  @unique /// @encryption:hash(email)
  createdAt DateTime @default(now())
  metadata  Json?
}

model Blacklist {
  id        String   @id @default(cuid())
  email     String   @unique /// @encrypted
  emailHash String?  @unique /// @encryption:hash(email)
  createdAt DateTime @default(now())
  metadata  Json?
}

model PharmaProject {
  id        String   @id @default(uuid())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?
}
