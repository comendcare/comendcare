generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewReplyReportReason {
  HARASSMENT
  FALSE
  SPAM
  SALES
  HATE
  OTHER
}

enum OrganizationToCompanyEngagement {
  EXPLORING
  QUOTE
  COLLABORATING
  COLLABORATED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String? /// @encrypted
  nameHash              String? /// @encryption:hash(name)
  username              String?
  email                 String?                @unique /// @encrypted
  emailHash             String?                @unique /// @encryption:hash(email)
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  kanbanLastVisit       DateTime               @default(now())
  address1              String? /// @encrypted
  address1Hash          String? /// @encryption:hash(address1)
  address2              String? /// @encrypted
  address2Hash          String? /// @encryption:hash(address2)
  city                  String? /// @encrypted
  cityHash              String? /// @encryption:hash(city)
  country               String? /// @encrypted
  countryHash           String? /// @encryption:hash(country)
  formattedAddress      String? /// @encrypted
  formattedAddressHash  String? /// @encryption:hash(formattedAddress)
  postalCode            String? /// @encrypted
  postalCodeHash        String? /// @encryption:hash(postalCode)
  region                String? /// @encrypted
  regionHash            String? /// @encryption:hash(region)
  lat                   String? /// @encrypted
  latHash               String? /// @encryption:hash(lat)
  lng                   String? /// @encrypted
  lngHash               String? /// @encryption:hash(lng)
  notificationSettings  Boolean                @default(false)
  consentSettings       Boolean                @default(false)
  accounts              Account[]
  requestComments       RequestComment[]
  postComments          PostComment[]
  follows               Follow[]
  sentInvitations       Member[]               @relation("invitedBy")
  memberships           Member[]
  membershipRequests    MemberRequest[]
  organizations         Organization[]
  posts                 Post[]
  reactions             Reaction[]
  roadmaps              Roadmap[]
  sessions              Session[]
  stakeholders          TaskStakeholder[]
  platformNotifications PlatformNotification[]
  reviews               Review[]
  replies               Reply[]
  reportOnReviews       ReportOnReview[]
  reportOnReplies       ReportOnReply[]
  reportOnComments      ReportOnComment[]
  reviewFeedbacks       ReviewFeedback[]
  metadata              Json?
  researcher            Researcher?
}

model PlatformNotification {
  id             String       @id @default(uuid())
  type           String // Stores the notification type (e.g. "NEW_TASK", "NEW_RECOMMENDATION")
  title          String
  message        String?
  link           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastViewedAt   DateTime?
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata       Json? // Stores additional information associated with this notification, e.g. for recommendations - company & milestone id

  @@index([userId, createdAt, lastViewedAt])
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role           String       @default("member") @db.VarChar
  title          String?
  email          String /// @encrypted
  emailHash      String? /// @encryption:hash(email)
  userId         String
  invitedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organizationId String
  invitedBy      User?        @relation("invitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata       Json?

  @@unique([userId, organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String /// @encrypted
  emailHash      String? /// @encryption:hash(email)
  role           String       @default("member") @db.VarChar
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  accepted       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata       Json?

  @@unique([emailHash, organizationId])
}

model MemberRequest {
  id             String       @id @default(cuid())
  userId         String
  email          String /// @encrypted
  emailHash      String? /// @encryption:hash(email)
  role           String       @default("member") @db.VarChar
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  approved       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata       Json?

  @@unique([userId, organizationId])
}

model Client {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  secret           String?
  type             ClientType    @default(WRITE)
  organizationSlug String
  organizationId   String?
  cors             String?
  crossDomain      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  organization     Organization? @relation(fields: [organizationId], references: [id])
  metadata         Json?
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata                 Json?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata     Json?

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid()) // PostgreSQL requires a primary key or explicitly defined replica identity for logical replication to track deletions.
  identifier String
  token      String   @unique
  expires    DateTime
  metadata   Json?

  @@unique([identifier, token])
}

model Roadmap {
  id             String        @id @default(cuid())
  title          String?
  description    String?
  content        String?
  slug           String        @default(cuid())
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  published      Boolean       @default(true)
  organizationId String?
  userId         String?
  edges          Edge[]
  milestones     Milestone[]
  nodes          Node[]
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  modalities     String[]
  metadata       Json?

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model RoadmapIdempotency {
  key         String   @id
  processedAt DateTime
}

model Node {
  id        String     @id @unique @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  positionX Int
  positionY Int
  origin    Float[]    @default([0.0, 0.0])
  roadmapId String
  data      Milestone?
  roadmap   Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  metadata  Json?
}

model Milestone {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  title            String
  description      String?
  notes            String?
  status           String?                    @default("PLANNED")
  budget           Int?
  endDate          DateTime?
  startDate        DateTime?
  private          Boolean                    @default(true)
  types            MilestoneTypeOnMilestone[]
  otherTypeDetails String?
  openTo           String[]
  tasks            Task[]
  attachments      ExternalAttachment[]
  contacts         ExternalContact[]
  timelineOrder    Int                        @default(0)
  nodeType         String                     @default("PROJECT")

  tools         ToolToMilestone[]
  biosamples    BiosampleToMilestone[]
  diseaseModels DiseaseModelToMilestone[]
  rfps          RFPToMilestone[]

  roadmapId      String
  roadmap        Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodeId         String?      @unique
  node           Node?        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  metadata       Json?

  reviews        MilestoneToReview[]
  savedCompanies SavedCompany[]
}

model Tool {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  title       String               @default("Untitled Tool")
  cohortSize  Int?
  description String?
  contacts    ExternalContact[]
  attachments ExternalAttachment[]
  private     Boolean              @default(true)
  pinned      Boolean              @default(false)
  metadata    Json?
  types       String[] // values (ToolType ids)

  institutionId  String?
  institution    Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  geneId         Int?
  gene           Gene?             @relation(fields: [geneId], references: [id])
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones     ToolToMilestone[]
}

model DiseaseModel {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  description String?
  contacts    ExternalContact[]
  attachments ExternalAttachment[]
  private     Boolean              @default(true)
  pinned      Boolean              @default(false)
  metadata    Json?
  types       String[] // values (DiseaseModelType ids)

  institutionId  String?
  institution    Institution?              @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  geneId         Int?
  gene           Gene?                     @relation(fields: [geneId], references: [id])
  conditionId    String?
  condition      Condition?                @relation(fields: [conditionId], references: [id])
  organizationId String?
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones     DiseaseModelToMilestone[]
}

model Biosample {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  description String?
  contacts    ExternalContact[]
  attachments ExternalAttachment[]
  private     Boolean              @default(true)
  pinned      Boolean              @default(false)
  metadata    Json?
  types       String[] // values (BiosampleType ids)

  gene                Gene?     @relation(fields: [geneId], references: [id])
  variant             String?
  availability        String?
  quantity            Float?
  quantityUnit        String?
  currentCountry      String?
  countryOfCollection String?
  preservationMethod  String?
  anatomicalSite      String?
  methodOfTransport   String?
  collectionDate      DateTime?
  ageAtCollection     Int?
  price               Float?
  priceUnit           String?

  institutionId  String?
  institution    Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  donor          Donor?                 @relation(fields: [donorId], references: [id])
  donorId        String?
  geneId         Int?
  organizationId String?
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones     BiosampleToMilestone[]
}

model DonorDiagnosis {
  id       String  @id @unique @default(uuid())
  severity String?

  donorId String
  donor   Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  typeId  String
  type    DiagnosisType @relation(fields: [typeId], references: [id], onDelete: Cascade)
}

model DiagnosisType {
  id    String @id @unique @default(uuid())
  label String

  diagnoses DonorDiagnosis[]
}

model Donor {
  id         String   @id @unique @default(uuid())
  internalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  age         Int?
  sex         String?
  gender      String?
  race        String?
  ethnicity   String?
  treatments  String[]
  diagnoses   DonorDiagnosis[]
  height      Float?
  weight      Float?
  bmi         Float?
  medications String[]
  species     String?

  biosamples     Biosample[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ToolToMilestone {
  id          String @id @default(uuid())
  toolId      String
  milestoneId String

  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  metadata  Json?

  @@unique([toolId, milestoneId])
}

model BiosampleToMilestone {
  id          String @id @default(uuid())
  biosampleId String
  milestoneId String

  biosample Biosample @relation(fields: [biosampleId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  metadata  Json?

  @@unique([biosampleId, milestoneId])
}

model DiseaseModelToMilestone {
  id             String @id @default(uuid())
  diseaseModelId String
  milestoneId    String

  diseaseModel DiseaseModel @relation(fields: [diseaseModelId], references: [id], onDelete: Cascade)
  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  metadata     Json?

  @@unique([diseaseModelId, milestoneId])
}

model RFP {
  id        String   @id @unique @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  title       String               @default("Untitled RFP")
  description String?
  openTo      String[]
  startDate   DateTime? // request opens
  endDate     DateTime? // deadline for proposals
  contacts    ExternalContact[]
  attachments ExternalAttachment[]
  budget      Int?
  private     Boolean              @default(true)
  headerImage String?              @db.Text
  pinned      Boolean              @default(false)
  metadata    Json?

  organizationId             String?
  organization               Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones                 RFPToMilestone[]
  companyContactRequestToRFP CompanyContactRequestToRFP[]
}

model RFPToMilestone {
  id          String @id @default(uuid())
  rfpId       String
  milestoneId String

  rfp       RFP       @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  metadata  Json?

  @@unique([rfpId, milestoneId])
}

model MilestoneToReview {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  reviewId    String
  review      Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  metadata    Json?
}

model MilestoneTypeOnMilestone {
  id              String        @id @default(uuid())
  milestoneTypeId String
  milestoneId     String
  milestoneType   MilestoneType @relation(fields: [milestoneTypeId], references: [id], onDelete: Cascade)
  milestone       Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  metadata        Json?

  @@unique([milestoneTypeId, milestoneId])
}

model MilestoneType {
  id          String   @id // value
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  label       String
  services    String[]
  categories  String[]
  description String?
  metadata    Json?

  milestones MilestoneTypeOnMilestone[]
}

model Kanban {
  id             String       @id @default(uuid())
  organizationId String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  columns        Column[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata       Json?
}

model Column {
  id             String   @id @unique @default(uuid())
  name           String   @default("New Column")
  kanbanId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  kanbanPosition Int      @default(0)
  kanban         Kanban   @relation(fields: [kanbanId], references: [id], onDelete: Cascade)
  tasks          Task[]
  metadata       Json?
}

model Task {
  id             String            @id @unique @default(uuid())
  name           String            @default("")
  description    String?           @default("")
  milestoneId    String?
  kanbanPosition Int
  orderPosition  Int
  columnId       String
  code           String            @unique @default(uuid()) @db.VarChar(128)
  title          String?           @db.VarChar(128)
  label          Label             @default(bug)
  estimatedHours Float             @default(0)
  archived       Boolean           @default(false)
  // status         String?           @default("PLANNED")
  status         Status?           @default(todo)
  priority       Priority?         @default(medium)
  createdAt      DateTime          @default(now())
  date           DateTime?         @default(now())
  updatedAt      DateTime          @updatedAt
  endDate        DateTime?
  private        Boolean           @default(true)
  startDate      DateTime?
  checklist      ChecklistItem[]
  column         Column            @relation(fields: [columnId], references: [id], onDelete: Cascade)
  milestone      Milestone?        @relation(fields: [milestoneId], references: [id])
  stakeholders   TaskStakeholder[]
  metadata       Json?
}

model TaskStakeholder {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata Json?

  @@unique([taskId, userId]) // Ensure uniqueness of the pair
}

model ChecklistItem {
  id            String  @id @unique @default(uuid())
  name          String
  complete      Boolean
  taskId        String
  orderPosition Int?
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  metadata      Json?
}

model ExternalAttachment {
  id   String  @id @unique @default(uuid())
  name String?
  link String

  toolId         String?
  tool           Tool?         @relation(fields: [toolId], references: [id])
  biosampleId    String?
  biosample      Biosample?    @relation(fields: [biosampleId], references: [id])
  rfpId          String?
  rfp            RFP?          @relation(fields: [rfpId], references: [id])
  milestoneId    String?
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id])
  metadata       Json?
  DiseaseModel   DiseaseModel? @relation(fields: [diseaseModelId], references: [id])
  diseaseModelId String?
}

model ExternalContact {
  id          String  @id @unique @default(uuid())
  name        String /// @encrypted
  nameHash    String? /// @encryption:hash(name)
  role        String?
  email       String /// @encrypted
  emailHash   String? /// @encryption:hash(email)
  affiliation String?

  toolId         String?
  tool           Tool?         @relation(fields: [toolId], references: [id])
  biosampleId    String?
  biosample      Biosample?    @relation(fields: [biosampleId], references: [id])
  rfpId          String?
  rfp            RFP?          @relation(fields: [rfpId], references: [id])
  milestoneId    String?
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id])
  metadata       Json?
  DiseaseModel   DiseaseModel? @relation(fields: [diseaseModelId], references: [id])
  diseaseModelId String?
}

model Edge {
  id        String  @id @unique @default(uuid())
  source    String
  target    String
  type      String?
  data      Json?
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  metadata  Json?
}

model Organization {
  id                            String                         @id @default(cuid())
  public                        Boolean                        @default(true)
  verified                      Boolean                        @default(false)
  published                     Boolean                        @default(true)
  name                          String?
  description                   String?                        @db.Text
  contactEmail                  String? /// @encrypted
  contactEmailHash              String? /// @encryption:hash(contactEmail)
  logo                          String?                        @default("https://public.blob.vercel-storage.com/eEZHAoPTOBSYGBE3/JRajRyC-PhBHEinQkupt02jqfKacBVHLWJq7Iy.png") @db.Text
  image                         String?                        @db.Text
  imageBlurhash                 String?                        @default("data:image/png;base64,") @db.Text
  headerImage                   String?                        @db.Text
  biopharmaConsentSettings      Boolean                        @default(false)
  subdomain                     String?                        @unique
  customDomain                  String?                        @unique
  message404                    String?                        @default("Blimey! You've found a page that doesn't exist.") @db.Text
  statedGoal                    Goal?
  yearFounded                   String?
  incorporationStatus           IncorporationStatus?
  therapeuticsOfInterest        String[]
  therapeuticsInDevelopment     String[]
  website                       String?
  moneyRaised                   Int?
  moneyDeployed                 Int?
  researchBudget                Int?
  address1                      String?
  address2                      String?
  formattedAddress              String?
  city                          String?
  region                        String?
  postalCode                    String?
  country                       String?
  lat                           String?
  lng                           String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  user                          User?                          @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId                        String?
  roadmaps                      Roadmap[]
  members                       Member[]
  clients                       Client[]
  invitations                   Invitation[]
  membershipRequests            MemberRequest[]
  conditions                    ConditionToOrganization[]
  kanban                        Kanban?
  milestones                    Milestone[]
  platformNotifications         PlatformNotification[]
  reviews                       Review[]
  savedCompanies                SavedCompany[]                 @relation("cro_save_organization")
  contactRequestedCompanies     CompanyContactRequest[]        @relation("cro_contact_request_organization")
  savedOrganizations            SavedOrganization[]            @relation("org_save_organization")
  savedByOrganizations          SavedOrganization[]            @relation("org_save_savedOrganization")
  tools                         Tool[]
  biosamples                    Biosample[]
  donors                        Donor[]
  rfps                          RFP[]
  materialAndDataAccessRequests MaterialAndDataAccessRequest[]
  metadata                      Json?
  diseaseModel                  DiseaseModel[]

  @@index([userId])
}

model SavedOrganization {
  id                  String @id @default(uuid())
  organizationId      String
  savedOrganizationId String

  organization      Organization @relation("org_save_organization", fields: [organizationId], references: [id], onDelete: Cascade)
  savedOrganization Organization @relation("org_save_savedOrganization", fields: [savedOrganizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  metadata  Json?

  @@unique([organizationId, savedOrganizationId]) // Ensures an organization can't save the same organization more than once
}

model Follow {
  id           String   @id @default(cuid())
  userId       String
  followedType String
  followedId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata     Json?

  @@unique([userId, followedType, followedId])
}

model Condition {
  id                          String                    @id @default(cuid())
  name                        String
  slug                        String                    @unique
  synonyms                    String[]
  description                 String?
  diseaseCategories           String[]
  prevalenceNumerator         Int?
  prevalenceDenominator       Int?
  numberOfPatientsEngaged     Int?
  nationalEstimatedPopulation Int?
  globalEstimatedPopulation   Int?
  relevantDiseaseMechanisms   String[]
  causalGenes                 String[]
  associatedGenes             String[]
  associatedSystems           String[]
  associatedSignsAndSymptoms  String[]
  existingDatabasesAndStudies String[]
  toolsUnderDevelopment       String[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  gardURL                     String?
  nordURL                     String?
  summary                     String?
  prevalenceRatio             Float?
  organizations               ConditionToOrganization[]
  metadata                    Json?
  DiseaseModel                DiseaseModel[]
}

model ConditionToOrganization {
  id             String  @id @default(uuid())
  conditionId    String?
  organizationId String?

  condition    Condition?    @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  metadata  Json?

  @@unique([conditionId, organizationId])
}

model Example {
  id            Int     @id @default(autoincrement())
  name          String?
  description   String?
  domainCount   Int?
  url           String?
  image         String?
  imageBlurhash String?
